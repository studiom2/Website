{% if section.settings.show_section %}
  <section class="m2-section m2-service-area full-width">
    <div class="m2-container m2-service-area__grid">
      <div class="m2-service-area__copy">
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="m2-rte">{{ section.settings.body }}</div>
      </div>
      <div class="m2-service-area__visual">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 781px) 50vw, 100vw', alt: section.settings.image.alt }}
        {% else %}
          {% render 'm2-placeholder-visual', asset_name: 'm2-service-area-map.svg', alt: section.settings.visual_alt, width: 1000, height: 700 %}
        {% endif %}
        {% if request.design_mode and section.settings.prototype_label != blank %}<span>{{ section.settings.prototype_label | escape }}</span>{% endif %}
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .m2-service-area { overflow: clip; background: color-mix(in srgb, var(--color-accent) 88%, var(--color-background)); }
  .m2-service-area__grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(3.5rem, 8vw, 8rem); }
  .m2-service-area h2 { max-width: 12ch; margin: 0 0 1.5rem; font-size: clamp(2.8rem, 5.5vw, 5.8rem); line-height: .96; }
  .m2-service-area__copy .m2-rte { max-width: 33rem; color: color-mix(in srgb, var(--color-foreground) 75%, transparent); line-height: 1.75; }
  .m2-service-area__visual { position: relative; }
  .m2-service-area__visual::before { content: ''; position: absolute; inset: 8% 6% -8% 12%; border: 1px solid color-mix(in srgb, var(--color-foreground) 15%, transparent); border-radius: var(--radius-large); transform: rotate(3deg); }
  .m2-service-area__visual > img { position: relative; width: 100%; aspect-ratio: 10 / 7; object-fit: cover; border-radius: var(--radius-large); box-shadow: var(--shadow-soft); }
  .m2-service-area__visual > span { position: absolute; right: 1rem; bottom: 1rem; padding: .45rem .7rem; border-radius: 999px; color: var(--color-muted); background: color-mix(in srgb, var(--color-surface) 88%, transparent); font-size: .52rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; backdrop-filter: blur(8px); }
  @media screen and (max-width: 780px) {
    .m2-service-area__grid { grid-template-columns: minmax(0, 1fr); }
    .m2-service-area__visual { max-width: 38rem; order: -1; }
    .m2-service-area__visual::before { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.m2_service_area",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "t:labels.show_section", "default": true },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "We werken in Zuid-Holland" },
    { "type": "richtext", "id": "body", "label": "t:labels.body", "default": "<p>We werken vooral in Delft, Den Haag, Rotterdam en het Westland.</p>" },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "text", "id": "visual_alt", "label": "t:labels.placeholder_alt", "default": "Tijdelijke abstracte kaartillustratie van het werkgebied in Zuid-Holland" },
    { "type": "text", "id": "prototype_label", "label": "t:labels.prototype_label", "default": "Indicatieve visual" }
  ],
  "presets": [{ "name": "t:general.m2_service_area" }]
}
{% endschema %}
