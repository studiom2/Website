{% if section.settings.show_section %}
  <section class="m2-final-cta full-width" aria-labelledby="CtaHeading-{{ section.id }}">
    <div class="m2-final-cta__pattern" aria-hidden="true"></div>
    <div class="m2-container m2-final-cta__inner">
      <h2 id="CtaHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.body | escape }}</p>
      <div class="m2-final-cta__actions">
        {% if settings.whatsapp_url != blank and section.settings.whatsapp_label != blank %}<a class="m2-button m2-button--light" href="{{ settings.whatsapp_url | escape }}">{{ section.settings.whatsapp_label | escape }}</a>{% endif %}
        {% if settings.contact_phone_url != blank and section.settings.phone_label != blank %}<a class="m2-button m2-final-cta__phone" href="{{ settings.contact_phone_url | escape }}">{{ section.settings.phone_label | escape }}</a>{% endif %}
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .m2-final-cta { position: relative; overflow: clip; padding-block: clamp(5rem, 10vw, 8rem); color: var(--color-background); background: var(--color-foreground); text-align: center; }
  .m2-final-cta__pattern { position: absolute; inset: 0; opacity: .18; background-image: linear-gradient(45deg, transparent 48.5%, var(--color-accent) 49%, var(--color-accent) 51%, transparent 51.5%); background-position: center; background-size: clamp(8rem, 18vw, 15rem) clamp(8rem, 18vw, 15rem); }
  .m2-final-cta__inner { position: relative; }
  .m2-final-cta h2 { max-width: 12ch; margin: 0 auto 1.4rem; color: inherit; font-size: clamp(3rem, 7vw, 6.8rem); line-height: .94; }
  .m2-final-cta__inner > p:not(.m2-eyebrow) { max-width: 36rem; margin: 0 auto; color: color-mix(in srgb, var(--color-background) 65%, transparent); font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.7; }
  .m2-final-cta__actions { margin-top: 2.5rem; display: flex; justify-content: center; align-items: center; gap: .8rem; flex-wrap: wrap; }
  .m2-final-cta__phone { border-color: color-mix(in srgb, var(--color-background) 45%, transparent); color: var(--color-background); background: transparent; box-shadow: none; }
  .m2-final-cta__phone:hover { border-color: var(--color-accent); }
  @media screen and (max-width: 520px) { .m2-final-cta { padding-block: 4rem; } .m2-final-cta__actions { align-items: stretch; flex-direction: column; } .m2-final-cta__actions .m2-button { width: 100%; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.m2_final_cta",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "t:labels.show_section", "default": true },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Even overleggen over je vloer?" },
    { "type": "textarea", "id": "body", "label": "t:labels.body", "default": "App of bel ons en vertel kort wat je wilt. Dan bespreken we wat er nodig is." },
    { "type": "text", "id": "whatsapp_label", "label": "t:labels.whatsapp_button", "default": "WhatsApp ons" },
    { "type": "text", "id": "phone_label", "label": "t:labels.phone_button", "default": "Bel ons" }
  ],
  "presets": [{ "name": "t:general.m2_final_cta" }]
}
{% endschema %}
