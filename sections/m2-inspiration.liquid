{% if section.settings.show_section %}
  <section class="m2-section m2-inspiration full-width">
    <div class="m2-container">
      <div class="m2-section-heading">
        <div><h2>{{ section.settings.heading | escape }}</h2></div>
        <div class="m2-section-heading__body">{{ section.settings.body }}</div>
      </div>
      <div class="m2-inspiration__grid">
        {% for block in section.blocks %}
          {% assign fallback_asset = block.settings.prototype_visual %}
          <article class="m2-inspiration-card" {{ block.shopify_attributes }}>
            <div class="m2-inspiration-card__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1100', sizes: '(min-width: 800px) 33vw, 100vw', alt: block.settings.image.alt }}
              {% else %}
                {% render 'm2-placeholder-visual', asset_name: fallback_asset, alt: block.settings.placeholder_label, width: 1000, height: 800 %}
              {% endif %}
              <span>{{ section.settings.demo_label | escape }}</span>
            </div>
            <div class="m2-inspiration-card__content">
              <div class="m2-inspiration-card__title"><h3>{{ block.settings.heading | escape }}</h3><strong>{{ block.settings.price | escape }}</strong></div>
              {% if block.settings.button_label != blank %}<a href="{% if block.settings.button_link != blank %}{{ block.settings.button_link }}{% elsif settings.whatsapp_url != blank %}{{ settings.whatsapp_url | escape }}{% else %}#contact{% endif %}">{{ block.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .m2-inspiration { background: var(--color-surface); }
  .m2-inspiration__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.25rem, 2.5vw, 2.25rem); }
  .m2-inspiration-card { overflow: hidden; border: 1px solid var(--color-border-light); border-radius: var(--radius-medium); background: var(--color-background); transition: box-shadow 220ms ease, transform 220ms ease; }
  .m2-inspiration-card:hover, .m2-inspiration-card:focus-within { box-shadow: var(--shadow-card); transform: translateY(-.35rem); }
  .m2-inspiration-card__media { position: relative; overflow: hidden; }
  .m2-inspiration-card__media > img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 500ms ease; }
  .m2-inspiration-card:hover .m2-inspiration-card__media > img { transform: scale(1.025); }
  .m2-inspiration-card__media > span { position: absolute; top: 1rem; left: 1rem; padding: .45rem .7rem; border-radius: 999px; color: var(--color-background); background: color-mix(in srgb, var(--color-foreground) 88%, transparent); font-size: .52rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; backdrop-filter: blur(8px); }
  .m2-inspiration-card__content { padding: 1.5rem; }
  .m2-inspiration-card__title { display: grid; gap: .65rem; }
  .m2-inspiration-card h3 { margin: 0; font-size: 1.7rem; line-height: 1.1; }
  .m2-inspiration-card strong { font-size: .72rem; }
  .m2-inspiration-card__content > a { width: fit-content; min-height: 2.75rem; display: inline-flex; align-items: center; margin-top: .8rem; color: inherit; font-size: .7rem; font-weight: 700; text-decoration: none; }
  .m2-inspiration-card__content > a span { margin-left: .35rem; color: var(--color-accent-strong); }
  .m2-inspiration-card__content > a:hover { text-decoration: underline; text-underline-offset: .3rem; }
  @media screen and (max-width: 800px) { .m2-inspiration__grid { grid-template-columns: 1fr; } .m2-inspiration-card { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); } .m2-inspiration-card__media > img { height: 100%; aspect-ratio: auto; } }
  @media screen and (max-width: 560px) { .m2-inspiration-card { display: block; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.m2_inspiration",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "t:labels.show_section", "default": true },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Een idee van wat er mogelijk is" },
    { "type": "richtext", "id": "body", "label": "t:labels.body", "default": "<p>Deze voorbeelden worden later vervangen door echte vloeren en actuele prijzen.</p>" },
    { "type": "text", "id": "demo_label", "label": "t:labels.demo_label", "default": "Voorbeeldinhoud" }
  ],
  "blocks": [{ "type": "example", "name": "t:general.inspiration_example", "settings": [{ "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Voorbeeld vloer 01" }, { "type": "text", "id": "price", "label": "t:labels.price", "default": "Vanaf € --,-- / m²" }, { "type": "image_picker", "id": "image", "label": "t:labels.image" }, { "type": "select", "id": "prototype_visual", "label": "t:labels.prototype_visual", "options": [{ "value": "m2-inspiration-sand.svg", "label": "t:options.inspiration_visual.sand" }, { "value": "m2-inspiration-oak.svg", "label": "t:options.inspiration_visual.oak" }, { "value": "m2-inspiration-stone.svg", "label": "t:options.inspiration_visual.stone" }], "default": "m2-inspiration-sand.svg" }, { "type": "text", "id": "placeholder_label", "label": "t:labels.placeholder_alt", "default": "Interieurillustratie voor een voorbeeldvloer" }, { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Vraag een offerte aan" }, { "type": "url", "id": "button_link", "label": "t:labels.button_link" }] }],
  "max_blocks": 6,
  "presets": [{ "name": "t:general.m2_inspiration", "blocks": [{ "type": "example", "settings": { "heading": "Voorbeeld vloer 01", "price": "Vanaf € --,-- / m²", "prototype_visual": "m2-inspiration-sand.svg", "placeholder_label": "Lichte interieurillustratie met een zandkleurige vloer", "button_label": "Vraag een offerte aan" } }, { "type": "example", "settings": { "heading": "Voorbeeld vloer 02", "price": "Vanaf € --,-- / m²", "prototype_visual": "m2-inspiration-oak.svg", "placeholder_label": "Warme interieurillustratie met een eikenkleurige vloer", "button_label": "Vraag een offerte aan" } }, { "type": "example", "settings": { "heading": "Voorbeeld vloer 03", "price": "Vanaf € --,-- / m²", "prototype_visual": "m2-inspiration-stone.svg", "placeholder_label": "Minimalistische interieurillustratie met een steenachtige vloer", "button_label": "Vraag een offerte aan" } }] }]
}
{% endschema %}
