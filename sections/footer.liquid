{% liquid
  assign privacy_url = section.settings.privacy_link
  if privacy_url == blank
    if shop.privacy_policy != blank
      assign privacy_url = shop.privacy_policy.url
    endif
  endif
%}

<footer class="m2-footer full-width" id="contact">
  <h2 class="visually-hidden">{{ section.settings.heading | escape }}</h2>
  <div class="m2-footer__inner m2-container">
    <div class="m2-footer__brand">
      <a class="m2-footer-brand{% if section.settings.invert_logo %} m2-footer-brand--invert{% endif %}" href="{{ routes.root_url }}" aria-label="{{ settings.business_name | escape }}" style="--logo-width: {{ settings.logo_width }}px">
        {% if settings.logo != blank %}
          {{ settings.logo | image_url: width: 420 | image_tag: loading: 'lazy', widths: '120, 180, 240, 360, 420', alt: settings.business_name }}
        {% else %}
          <span aria-hidden="true">m²</span>
          <strong>{{ settings.business_name | escape }}</strong>
        {% endif %}
      </a>
      <p>{{ section.settings.tagline | escape }}</p>
    </div>

    <div class="m2-footer__column">
      <h3>{{ section.settings.navigation_heading | escape }}</h3>
      <nav class="m2-footer__links" aria-label="{{ section.settings.navigation_heading | escape }}">
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}
        {% else %}
          <a href="{{ routes.root_url }}#vloeren">{{ section.settings.floors_label | escape }}</a>
          <a href="{{ routes.root_url }}#showroom">{{ section.settings.showroom_label | escape }}</a>
          <a href="{{ routes.root_url }}#projecten">{{ section.settings.projects_label | escape }}</a>
          <a href="{{ routes.root_url }}#werkwijze">{{ section.settings.process_label | escape }}</a>
          <a href="{{ routes.root_url }}#over-ons">{{ section.settings.about_label | escape }}</a>
        {% endif %}
      </nav>
    </div>

    <div class="m2-footer__column">
      <h3>{{ section.settings.contact_heading | escape }}</h3>
      <div class="m2-footer__links">
        {% if settings.contact_phone != blank and settings.contact_phone_url != blank %}<a href="{{ settings.contact_phone_url | escape }}">{{ settings.contact_phone | escape }}</a>{% endif %}
        {% if settings.contact_email != blank %}<a href="mailto:{{ settings.contact_email | escape }}">{{ settings.contact_email | escape }}</a>{% endif %}
      </div>
    </div>

    <div class="m2-footer__column">
      <h3>{{ section.settings.area_heading | escape }}</h3>
      <p>{{ section.settings.area_text | escape }}</p>
      <div class="m2-footer__socials">
        {% if settings.instagram_url != blank %}<a href="{{ settings.instagram_url | escape }}">{{ 'm2.social.instagram' | t }} <span aria-hidden="true">↗</span></a>{% endif %}
        {% if settings.tiktok_url != blank %}<a href="{{ settings.tiktok_url | escape }}">{{ 'm2.social.tiktok' | t }} <span aria-hidden="true">↗</span></a>{% endif %}
      </div>
    </div>
  </div>

  <div class="m2-footer__bottom m2-container">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ settings.business_name | escape }}</span>
    {% if privacy_url != blank %}<a href="{{ privacy_url }}">{{ section.settings.privacy_label | escape }}</a>{% endif %}
  </div>
</footer>

{% stylesheet %}
  .m2-footer { padding-block: clamp(4.5rem, 8vw, 7.5rem) 1.5rem; color: var(--color-background); background: var(--color-foreground); }
  .m2-footer__inner { padding-bottom: clamp(3.5rem, 6vw, 5rem); display: grid; grid-template-columns: 1.65fr repeat(3, 1fr); gap: clamp(2.5rem, 5vw, 6rem); }
  .m2-footer-brand { display: inline-flex; align-items: center; gap: .8rem; color: inherit; text-decoration: none; }
  .m2-footer-brand > span { width: 2.9rem; height: 2.9rem; display: grid; place-items: center; border-radius: 50%; color: var(--color-foreground); background: var(--color-accent); font-family: var(--font-display-family); font-size: 1.35rem; font-style: italic; }
  .m2-footer-brand strong { font-size: 1.05rem; }
  .m2-footer-brand img { width: min(var(--logo-width), 15rem); max-width: 100%; max-height: 3.5rem; object-fit: contain; object-position: left center; }
  .m2-footer-brand--invert img { filter: invert(1); }
  .m2-footer__brand > p { max-width: 22rem; margin: 1.5rem 0 1rem; color: color-mix(in srgb, var(--color-background) 65%, transparent); line-height: 1.7; }
  .m2-footer__column h3 { margin: 0 0 1.4rem; color: var(--color-accent); font: 700 .65rem/1 var(--font-body-family); letter-spacing: .16em; text-transform: uppercase; }
  .m2-footer__column > p { max-width: 17rem; color: color-mix(in srgb, var(--color-background) 62%, transparent); font-size: .82rem; line-height: 1.7; }
  .m2-footer__links { display: grid; gap: .7rem; }
  .m2-footer__links a { width: fit-content; max-width: 100%; min-height: 2.75rem; display: flex; align-items: center; color: color-mix(in srgb, var(--color-background) 78%, transparent); font-size: .8rem; text-decoration: none; overflow-wrap: anywhere; }
  .m2-footer__links a:hover { color: var(--color-accent); }
  .m2-footer__socials { margin-top: 1.4rem; display: flex; gap: 1rem; flex-wrap: wrap; }
  .m2-footer__socials a { min-height: 2.75rem; display: inline-flex; align-items: center; color: inherit; font-size: .75rem; font-weight: 700; text-decoration: none; }
  .m2-footer__socials span { color: var(--color-accent); }
  .m2-footer__bottom { padding-top: 1.25rem; display: flex; align-items: center; gap: 1.25rem; color: color-mix(in srgb, var(--color-background) 68%, transparent); border-top: 1px solid color-mix(in srgb, var(--color-background) 12%, transparent); font-size: .65rem; }
  .m2-footer__bottom a { min-width: 2.75rem; min-height: 2.75rem; margin-left: auto; display: inline-flex; align-items: center; color: inherit; text-underline-offset: .25rem; }
  @media screen and (max-width: 900px) {
    .m2-footer__inner { grid-template-columns: 1.4fr 1fr 1fr; }
    .m2-footer__brand { grid-column: 1 / -1; }
  }
  @media screen and (max-width: 640px) {
    .m2-footer { padding-top: 2.5rem; }
    .m2-footer__inner { padding-bottom: 2rem; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
    .m2-footer__brand, .m2-footer__column:last-child { grid-column: auto; }
    .m2-footer__brand > p { margin: 1rem 0 0; }
    .m2-footer__column h3 { margin-bottom: .75rem; }
    .m2-footer__links { gap: .25rem; }
    .m2-footer__socials { margin-top: .75rem; }
    .m2-footer__bottom { padding-top: 1rem; align-items: center; flex-direction: row; gap: 1rem; }
    .m2-footer__bottom a { margin-left: auto; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Studio m2 vloeren" },
    { "type": "text", "id": "tagline", "label": "t:labels.introduction", "default": "Vloeren leveren, leggen en afwerken in Zuid-Holland." },
    { "type": "checkbox", "id": "invert_logo", "label": "t:labels.invert_logo", "default": false },
    { "type": "link_list", "id": "menu", "label": "t:labels.menu" },
    { "type": "text", "id": "floors_label", "label": "t:labels.floors_label", "default": "Vloeren" },
    { "type": "text", "id": "showroom_label", "label": "t:labels.showroom_label", "default": "Rijdende showroom" },
    { "type": "text", "id": "projects_label", "label": "t:labels.projects_label", "default": "Projecten" },
    { "type": "text", "id": "process_label", "label": "t:labels.process_label", "default": "Werkwijze" },
    { "type": "text", "id": "about_label", "label": "t:labels.about_label", "default": "Over ons" },
    { "type": "text", "id": "navigation_heading", "label": "t:labels.navigation_heading", "default": "Ontdek" },
    { "type": "text", "id": "contact_heading", "label": "t:labels.contact_heading", "default": "Neem contact op" },
    { "type": "text", "id": "area_heading", "label": "t:labels.area_heading", "default": "Werkgebied" },
    { "type": "text", "id": "area_text", "label": "t:labels.service_area", "default": "Delft, Den Haag, Rotterdam en het Westland" },
    { "type": "url", "id": "privacy_link", "label": "t:labels.privacy_link" },
    { "type": "text", "id": "privacy_label", "label": "t:labels.privacy_label", "default": "Privacy" }
  ]
}
{% endschema %}
