{% if section.settings.show_section %}
  <section class="m2-section m2-showroom full-width" id="showroom">
    <div class="m2-container m2-showroom__grid">
      <div class="m2-showroom__media">
        <div class="m2-showroom__image">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 851px) 55vw, 100vw', alt: section.settings.image.alt }}
          {% else %}
            {% render 'm2-placeholder-visual', asset_name: 'm2-showroom-van.svg', alt: section.settings.placeholder_label, width: 1200, height: 900 %}
          {% endif %}
        </div>
        {% if request.design_mode and section.settings.prototype_label != blank %}<span class="m2-showroom__prototype">{{ section.settings.prototype_label | escape }}</span>{% endif %}
      </div>
      <div class="m2-showroom__copy">
        <p class="m2-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="m2-rte">{{ section.settings.body }}</div>
        {% if section.settings.caption != blank %}<p class="m2-showroom__note">{{ section.settings.caption | escape }}</p>{% endif %}
        {% if section.settings.button_label != blank %}<a class="m2-button" href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% elsif settings.whatsapp_url != blank %}{{ settings.whatsapp_url | escape }}{% else %}#contact{% endif %}">{{ section.settings.button_label | escape }}</a>{% endif %}
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .m2-showroom { background: var(--color-surface); }
  .m2-showroom__grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); align-items: center; gap: clamp(2.5rem, 7vw, 7rem); }
  .m2-showroom__media { position: relative; padding: 1.25rem 0 2.5rem 1.25rem; }
  .m2-showroom__media::before { content: ''; position: absolute; inset: 0 12% 12% 0; border-radius: var(--radius-large); background: color-mix(in srgb, var(--color-accent) 20%, var(--color-background)); }
  .m2-showroom__image { position: relative; overflow: hidden; aspect-ratio: 4 / 3; border-radius: var(--radius-large); box-shadow: var(--shadow-soft); }
  .m2-showroom__image > img { width: 100%; height: 100%; object-fit: cover; }
  .m2-showroom__prototype { position: absolute; top: 2.2rem; left: 2.2rem; padding: .5rem .75rem; border-radius: 999px; color: var(--color-muted); background: color-mix(in srgb, var(--color-surface) 88%, transparent); font-size: .58rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; backdrop-filter: blur(8px); }
  .m2-showroom__copy h2 { max-width: 12ch; margin: 1rem 0 1.5rem; font-size: clamp(2.8rem, 5vw, 5.4rem); line-height: .96; }
  .m2-showroom__copy .m2-rte { max-width: 31rem; color: var(--color-muted); line-height: 1.75; }
  .m2-showroom__note { max-width: 31rem; margin: 1.4rem 0 1.8rem; padding-left: 1rem; color: var(--color-muted); border-left: 2px solid var(--color-accent); font-size: .82rem; line-height: 1.65; }
  @media screen and (max-width: 850px) {
    .m2-showroom__grid { grid-template-columns: minmax(0, 1fr); }
    .m2-showroom__media { max-width: 42rem; }
  }
  @media screen and (max-width: 520px) {
    .m2-showroom__media { padding: .65rem 0 2rem .65rem; }
    .m2-showroom__image { border-radius: var(--radius-medium); }
    .m2-showroom__prototype { top: 1.2rem; left: 1.2rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.m2_showroom",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "t:labels.show_section", "default": true },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Rijdende showroom" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Vloeren bekijken in je eigen huis" },
    { "type": "richtext", "id": "body", "label": "t:labels.body", "default": "<p>App of bel ons en vertel wat je zoekt. Als het past, komen we met stalen langs. Zo zie je thuis meteen welke kleur en structuur goed werken. Daarna krijg je een duidelijke offerte.</p>" },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "text", "id": "placeholder_label", "label": "t:labels.placeholder_alt", "default": "Tijdelijke illustratie van de rijdende showroom met vloerstaaltjes" },
    { "type": "text", "id": "prototype_label", "label": "t:labels.prototype_label", "default": "Tijdelijke visual" },
    { "type": "text", "id": "caption", "label": "t:labels.caption", "default": "Een stalenbezoek doen we bij een concrete vloerwens. Het bezoek en de offerte zijn kosteloos." },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "App ons over je vloer" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" }
  ],
  "presets": [{ "name": "t:general.m2_showroom" }]
}
{% endschema %}
