{% if section.settings.show_section %}
  <section class="m2-section m2-process full-width" id="werkwijze">
    <div class="m2-container">
      <div class="m2-process__intro">
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      <ol class="m2-process__steps">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>
            <div class="m2-process__number"><span>0{{ forloop.index }}</span>{% unless forloop.last %}<i aria-hidden="true"></i>{% endunless %}</div>
            <div><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.body | escape }}</p></div>
          </li>
        {% endfor %}
      </ol>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .m2-process { color: var(--color-background); background: var(--color-foreground); }
  .m2-process__intro h2 { max-width: 11ch; margin: 0; color: inherit; font-size: clamp(2.8rem, 5.5vw, 5.8rem); line-height: .96; }
  .m2-process__steps { margin: clamp(2.75rem, 5vw, 4.5rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; }
  .m2-process__steps li { min-width: 0; min-height: 12rem; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; border-top: 1px solid color-mix(in srgb, var(--color-background) 14%, transparent); border-left: 1px solid color-mix(in srgb, var(--color-background) 14%, transparent); }
  .m2-process__steps li:nth-child(4n+1) { border-left: 0; }
  .m2-process__number { display: flex; align-items: center; gap: .75rem; }
  .m2-process__number span { width: 2.65rem; height: 2.65rem; display: grid; place-items: center; flex: 0 0 auto; border: 1px solid color-mix(in srgb, var(--color-background) 22%, transparent); border-radius: 50%; color: var(--color-accent); font-family: var(--font-display-family); font-size: .82rem; font-style: italic; }
  .m2-process__number i { width: 100%; height: 1px; background: color-mix(in srgb, var(--color-background) 16%, transparent); }
  .m2-process__steps h3 { margin: 0 0 .7rem; color: inherit; font-size: clamp(1.2rem, 1.7vw, 1.55rem); line-height: 1.12; }
  .m2-process__steps p { margin: 0; color: color-mix(in srgb, var(--color-background) 68%, transparent); font-size: .7rem; line-height: 1.6; }
  @media screen and (max-width: 1020px) {
    .m2-process__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .m2-process__steps li:nth-child(odd) { border-left: 0; }
    .m2-process__steps li:nth-child(even) { border-left: 1px solid color-mix(in srgb, var(--color-background) 14%, transparent); }
  }
  @media screen and (max-width: 600px) {
    .m2-process__steps { grid-template-columns: minmax(0, 1fr); }
    .m2-process__steps li, .m2-process__steps li:nth-child(even) { min-height: 0; padding: 1.25rem 0; display: grid; grid-template-columns: auto minmax(0, 1fr); justify-content: initial; gap: 1rem; border-left: 0; }
    .m2-process__number { height: 100%; flex-direction: column; }
    .m2-process__number i { width: 1px; height: auto; min-height: 1rem; flex: 1; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.m2_process",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "t:labels.show_section", "default": true },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Zo werken we" }
  ],
  "blocks": [{ "type": "step", "name": "t:general.step", "settings": [{ "type": "text", "id": "heading", "label": "t:labels.heading", "default": "App of bel ons" }, { "type": "text", "id": "body", "label": "t:labels.body", "default": "Vertel kort wat je zoekt en wat de situatie is." }] }],
  "max_blocks": 7,
  "presets": [{ "name": "t:general.m2_process", "blocks": [{ "type": "step", "settings": { "heading": "App of bel ons", "body": "Vertel kort wat je zoekt en wat de situatie is." } }, { "type": "step", "settings": { "heading": "We bespreken de klus", "body": "We kijken naar de vloer, de ondergrond en de gewenste afwerking." } }, { "type": "step", "settings": { "heading": "Stalen bekijken", "body": "Bij serieuze interesse komen we met passende stalen langs." } }, { "type": "step", "settings": { "heading": "Duidelijke offerte", "body": "Je ziet vooraf wat we leveren en welke werkzaamheden we uitvoeren." } }, { "type": "step", "settings": { "heading": "Voorbereiden", "body": "We verwijderen en egaliseren waar dat nodig is." } }, { "type": "step", "settings": { "heading": "Leggen en afwerken", "body": "We leggen de vloer en plaatsen de plinten." } }, { "type": "step", "settings": { "heading": "Netjes opleveren", "body": "Als het werk klaar is, leveren we de ruimte netjes op." } }] }]
}
{% endschema %}
