[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.business_details",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "t:labels.logo_width",
        "default": 150
      },
      {
        "type": "text",
        "id": "business_name",
        "label": "t:labels.business_name",
        "default": "Studio m2 vloeren"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "t:labels.phone_display",
        "default": "06-85887536"
      },
      {
        "type": "text",
        "id": "contact_phone_url",
        "label": "t:labels.phone_url",
        "default": "tel:+31685887536"
      },
      {
        "type": "text",
        "id": "whatsapp_url",
        "label": "t:labels.whatsapp_url",
        "default": "https://wa.me/31685887536"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "t:labels.email",
        "default": "studiom2vloeren@proton.me"
      },
      {
        "type": "text",
        "id": "instagram_url",
        "label": "t:labels.instagram_url",
        "default": "https://www.instagram.com/studiom2vloeren/"
      },
      {
        "type": "text",
        "id": "tiktok_url",
        "label": "t:labels.tiktok_url"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "72rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "78rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "78rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 40
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#F5F2EC",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#171713",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#FFFFFF",
        "label": "t:labels.surface"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#B69A75",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#6D6A62",
        "label": "t:labels.muted"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
